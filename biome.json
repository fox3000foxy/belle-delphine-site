{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!dist", "!node_modules", "!public", "!**/*.svg"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 320
  },
  "javascript": { "formatter": { "jsxQuoteStyle": "single", "quoteStyle": "single", "trailingCommas": "es5", "arrowParentheses": "asNeeded", "semicolons": "always", "bracketSameLine": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
      "suspicious": { "noExplicitAny": "off" },
      "style": { "useConst": "error", "noNonNullAssertion": "off" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
